{
  "database_name": "Trino Iceberg Gold Keuangan",
  "sqlalchemy_uri": "trino://trino@trino:8080/iceberg/gold",
  "schema": "gold",
  "table_name": "fact_anggaran",
  "main_dttm_col": null,
  "columns": [
    "item_id",
    "run_id",
    "tahun",
    "periode",
    "prodi",
    "fakultas",
    "kegiatan",
    "cluster_kegiatan",
    "akun",
    "kode_akun",
    "nama_akun",
    "iku",
    "kode_iku",
    "nama_iku",
    "nomenklatur_path",
    "uraian_detail",
    "qty",
    "satuan",
    "harga_satuan",
    "jumlah",
    "allocation_weight",
    "jumlah_weighted_iku",
    "mapping_status",
    "data_quality_flag",
    "source_file",
    "source_sheet",
    "source_row",
    "created_at"
  ],
  "metrics": [
    {"label": "Total Anggaran", "expression": "SUM(jumlah)"},
    {"label": "Total Weighted IKU", "expression": "SUM(jumlah_weighted_iku)"},
    {"label": "Jumlah Item", "expression": "COUNT(DISTINCT item_id)"},
    {"label": "Jumlah IKU", "expression": "COUNT(DISTINCT kode_iku)"},
    {"label": "Jumlah Kegiatan", "expression": "COUNT(DISTINCT kegiatan)"}
  ],
  "hidden_columns": [
    "mapping_status",
    "data_quality_flag",
    "source_sheet",
    "source_row"
  ]
}
