{
  "dashboard_title": "SILARAS SD - Dashboard Anggaran IKU",
  "charts": [
    {"name": "KPI Total Anggaran", "viz_type": "big_number_total", "metric": "SUM(jumlah)"},
    {"name": "KPI Total Anggaran Weighted IKU", "viz_type": "big_number_total", "metric": "SUM(jumlah_weighted_iku)"},
    {"name": "KPI Jumlah IKU", "viz_type": "big_number_total", "metric": "COUNT(DISTINCT kode_iku)"},
    {"name": "KPI Jumlah Kegiatan", "viz_type": "big_number_total", "metric": "COUNT(DISTINCT kegiatan)"},
    {"name": "KPI Jumlah Item", "viz_type": "big_number_total", "metric": "COUNT(DISTINCT item_id)"},
    {"name": "Anggaran per IKU", "viz_type": "echarts_timeseries_bar", "groupby": ["iku"], "metric": "SUM(jumlah_weighted_iku)"},
    {"name": "Treemap IKU to Cluster Kegiatan", "viz_type": "treemap_v2", "groupby": ["iku", "cluster_kegiatan"], "metric": "SUM(jumlah_weighted_iku)"},
    {"name": "Anggaran per Akun", "viz_type": "echarts_timeseries_bar", "groupby": ["akun"], "metric": "SUM(jumlah)"},
    {"name": "Detail Item Biaya", "viz_type": "table", "columns": ["tahun", "periode", "prodi", "iku", "kegiatan", "akun", "uraian_detail", "qty", "harga_satuan", "jumlah", "source_file"]},
    {"name": "Validation Reconciliation", "viz_type": "table", "source": "gold.vw_dashboard_reconciliation"}
  ],
  "hidden_columns": ["mapping_status", "data_quality_flag", "source_sheet", "source_row"],
  "note": "Kolom pada hidden_columns tidak ditampilkan di chart/dataset Superset, tetapi tetap ada di tabel gold.fact_anggaran."
