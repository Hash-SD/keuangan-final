# Salin ke .env (atau set langsung di environment host).

# Base URL Superset. Di dalam network compose utama pakai http://superset:8088.
# Untuk dev lokal (Superset berjalan di host) pakai http://localhost:8089.
SUPERSET_BASE_URL=http://superset:8088

# Kredensial Superset (API login).
SUPERSET_USERNAME=admin
SUPERSET_PASSWORD=admin

# Timeout permintaan API Superset (detik).
SUPERSET_API_TIMEOUT_SECONDS=12
